// The whole repo lints on biome's recommended rules and formats on its defaults.
// `bun run lint` and `bun run format` run it, with ruff, over the whole tree from anywhere in the repo.
{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		// The vendored rrweb bundles, the generated constants files, and the test fixtures (a stand-in
		// visitor site and the recording captured from it) are not authored here. Markdown stays out:
		// biome's Markdown formatter reads neither frontmatter nor GitHub tables, and rewrites both.
		"includes": [
			"**",
			"!**/*.md",
			"!evidence/vendor",
			"!evidence/tests/fixtures",
			"!evidence/distill/rrweb_constants.js",
			"!evidence/distill/html_semantics.js",
			"!recorder/src/rrweb_constants.js"
		]
	},
	"formatter": { "enabled": true },
	"assist": { "enabled": true },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				// The recorder writes document.cookie directly; the Cookie Store API the rule
				// prefers is not available across the browsers the recorder must run in.
				"noDocumentCookie": "off"
			}
		}
	}
}
